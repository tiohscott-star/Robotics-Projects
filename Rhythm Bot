        break;
      case 'd':
        digitalWrite(23,LOW);
        digitalWrite(25,HIGH);
        break;
      case 'a':
        digitalWrite(27,LOW);
        digitalWrite(32,HIGH);
        break;
  } //end of switchcase
  } //end of lightup
} //end of light2()


void Light3(){
    if(running_millis%light3[gol3]<=error){
      State3=true;
    }else{State3 = false;}
  if(State3 == true){
    gol4=gol3;
    NOTE=notes[gol3];
    switch(NOTE){
      case 'e':
        digitalWrite(5,LOW);
        digitalWrite(6,HIGH);
        break;
      case 'c':
        digitalWrite(14,LOW);
        digitalWrite(15,HIGH);
        break;
      case 'g':
        digitalWrite(17,LOW);
        digitalWrite(18,HIGH);
        break;
      case 'f':
        digitalWrite(21,LOW);
        digitalWrite(22,HIGH);
        break;
      case 'd':
        digitalWrite(25,LOW);
        digitalWrite(26,HIGH);
        break;
      case 'a':
        digitalWrite(32,LOW);
        digitalWrite(33,HIGH);
  } //end of switchcase
  } //end of lightup
} //end of light3()


void Sound(){
  if(running_millis%sound[gol4]<=error){
    int duration = beats[gol4]*tempo;
    State4=true;
  }else{State4 = false;
  once2=0;}
  if(State4 == true){
    once2++;
    if(once2==1){
      NOTE=notes[gol4];
      switch(NOTE){
        case 'e':
          if(digitalRead(34)==HIGH){
            tone(BuzzerPin,e,200);}
            else{tone(BuzzerPin,100,300);}
          digitalWrite(12,LOW);
          break;
        case 'c':
          if(digitalRead(35)==HIGH){
            tone(BuzzerPin,c,200);}
            else{tone(BuzzerPin,100,300);}
          digitalWrite(15,LOW);
          break;
        case 'g':
          if(digitalRead(35)==HIGH){
            tone(BuzzerPin,g,200);}
            else{tone(BuzzerPin,100,300);}
          digitalWrite(18,LOW);
          break;
        case 'f':
          if(digitalRead(36)==HIGH){
            tone(BuzzerPin,f,200);}
            else{tone(BuzzerPin,100,300);}
          digitalWrite(22,LOW);
          break;
        case 'd':
          if(digitalRead(39)==HIGH){
            tone(BuzzerPin,d,200);}
            else{tone(BuzzerPin,100,300);}
          digitalWrite(26,LOW);
          break;
        case 'a':
          if(digitalRead(39)==HIGH){
            tone(BuzzerPin,a,200);}
            else{tone(BuzzerPin,100,300);}
           digitalWrite(33,LOW);
          break;
        
        
      } //end of switchcase
    } //end of once2
  } //end of lightup
} //end of light1()
